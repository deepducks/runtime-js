{
  "command": "",
  "providers": {
    "its": "github",
    "git": "github",
    "llm": "claude"
  },
  "defaults": {
    "model": "claude-sonnet-5",
    "effort": "high",
    "base_branch": "main"
  },
  "product": {
    "enabled": false
  },
  "update": {
    "enabled": true,
    "schedule": "23 6 * * 1",
    "channel": "stable",
    "pin": null,
    "mode": "pr",
    "auto_merge": "off",
    "on_drift": "warn",
    "notify_issue": null,
    "source_repo": "deepducks/autoducks"
  },
  "triggers": {
    "update": []
  },
  "security": {
    "per_agent": {
      "update": {
        "trusted_associations": [
          "OWNER",
          "MEMBER"
        ]
      }
    }
  }
}
